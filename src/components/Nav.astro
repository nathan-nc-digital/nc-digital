---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

const serviceLinks = [
  { href: '/services/web-design/',                        label: 'Web Design' },
  { href: '/services/ecommerce-development/',             label: 'Ecommerce Development' },
  { href: '/services/logo-design/',                       label: 'Logo Design & Branding' },
  { href: '/services/web-development/',                   label: 'Web Development' },
  { href: '/services/managed-starter-websites/',          label: 'Managed Starter Websites' },
  { href: '/services/website-hosting-security/',          label: 'Website Hosting & Security' },
  { href: '/services/website-maintenance-packages/',      label: 'Website Maintenance' },
  { href: '/services/local-seo-google-ranking/',          label: 'Local SEO & Google Ranking' },
  { href: '/services/professional-mailboxes-email-setup/', label: 'Professional Email Setup' },
];

const navLinks = [
  { href: '/portfolio/', label: 'Portfolio' },
  { href: '/blog/',      label: 'Blog' },
  { href: '/about/',     label: 'About Us' },
];

const socials = [
  { href: 'https://wa.me/447397504779?text=Hi%2C%20I%27d%20like%20a%20quote%20for%20a%20website.', label: 'WhatsApp', icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>` },
  { href: 'https://www.facebook.com/profile.php?id=61575891781927', label: 'Facebook', icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>` },
  { href: 'https://x.com/ncdigitaluk',                   label: 'X', icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>` },
  { href: 'https://www.instagram.com/ncdigitaluk/',      label: 'Instagram', icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>` },
  { href: 'https://www.linkedin.com/company/26759059/', label: 'LinkedIn', icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>` },
];

const currentPath = Astro.url.pathname;
const servicesActive = currentPath.startsWith('/services/');
---

<nav id="site-nav" data-animate="fade-in">
  <div class="nav-inner container site-pad">

    <a href="/" class="nav-logo" aria-label="NC Digital — Home">
      <Image src={logo} alt="NC Digital" height={36} densities={[1, 2, 3]} quality={100} style="display:block; height:36px; width:auto;" />
    </a>

    <ul class="nav-links">
      <li class="nav-item has-dropdown">
        <a href="/services/" class={`nav-link${servicesActive ? ' nav-link--active' : ''}`}>
          Services
          <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <div class="dropdown">
          <a href="/services/" class="dropdown-all">All Services</a>
          {serviceLinks.map(({ href, label }) => (
            <a href={href} class={`dropdown-item${currentPath.startsWith(href) ? ' dropdown-item--active' : ''}`}>
              {label}
            </a>
          ))}
        </div>
      </li>

      {navLinks.map(({ href, label }) => (
        <li class="nav-item">
          <a href={href} class={`nav-link${currentPath.startsWith(href) ? ' nav-link--active' : ''}`}>
            {label}
          </a>
        </li>
      ))}
      <li class="nav-item">
        <a href="/free-website-plan/" class={`nav-link${currentPath === '/free-website-plan/' ? ' nav-link--active' : ''}`}>
          Get Free Plan
        </a>
      </li>
    </ul>

    <div class="nav-right">
      <div class="nav-socials">
        {socials.map(({ href, label, icon }) => (
          <a href={href} target="_blank" rel="noopener noreferrer" aria-label={label} class="social-link" set:html={icon} />
        ))}
      </div>
      <a href="/contact/" class="btn-primary nav-cta">Hire us <span class="nav-cta-arrow">→</span></a>
    </div>

    <button class="hamburger" id="hamburger-btn" aria-label="Toggle menu" aria-expanded="false">
      <span class="bar bar-1"></span>
      <span class="bar bar-2"></span>
      <span class="bar bar-3"></span>
    </button>

  </div>
</nav>

<!-- Full-screen mobile overlay (outside nav, fixed) -->
<div class="mob-overlay" id="mob-overlay" aria-hidden="true" inert>
  <div class="mob-panel" id="mob-panel">

    <!-- Close button -->
    <button class="mob-close" id="mob-close" aria-label="Close menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>

    <div class="mob-nav" role="navigation">

      <!-- Services accordion -->
      <div class="mob-item" data-mob-item>
        <button class="mob-link mob-services-btn" id="mob-services-btn" aria-expanded="false">
          <span>Services</span>
          <svg class="mob-chevron" width="14" height="14" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="mob-sub" id="mob-sub">
          <a href="/services/" class="mob-sub-link">All Services →</a>
          {serviceLinks.map(({ href, label }) => (
            <a href={href} class="mob-sub-link">{label}</a>
          ))}
        </div>
      </div>

      {navLinks.map(({ href, label }) => (
        <div class="mob-item" data-mob-item>
          <a href={href} class={`mob-link${currentPath.startsWith(href) ? ' mob-link--active' : ''}`}>
            {label}
          </a>
        </div>
      ))}

      <div class="mob-item" data-mob-item>
        <a href="/free-website-plan/" class={`mob-link${currentPath === '/free-website-plan/' ? ' mob-link--active' : ''}`}>
          Free Website Plan
        </a>
      </div>

    </div>

    <div class="mob-footer" data-mob-footer>
      <a href="/contact/" class="btn-primary mob-cta">Hire us →</a>
      <div class="mob-socials">
        {socials.map(({ href, label, icon }) => (
          <a href={href} target="_blank" rel="noopener noreferrer" aria-label={label} class="mob-social" set:html={icon} />
        ))}
      </div>
    </div>

  </div>
</div>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 1px 40px rgba(135, 80, 247, 0.18), 0 1px 0 var(--border);
    transition: background 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .nav-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 72px;
    gap: 2rem;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item { position: relative; }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: color 0.25s ease;
    position: relative;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1.5px;
    background: var(--purple);
    transition: width 0.25s ease;
  }
  .nav-link:hover,
  .nav-link--active { color: var(--white); }
  .nav-link:hover::after,
  .nav-link--active::after { width: 100%; }

  .dropdown-chevron {
    transition: transform 0.2s ease;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .has-dropdown:hover .dropdown-chevron { transform: rotate(180deg); }

  .dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    min-width: 240px;
    background: var(--bg-3);
    border: 1px solid var(--border-2);
    border-radius: 8px;
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 2px;
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) translateY(-6px);
    transition: opacity 0.18s ease, transform 0.18s ease;
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
  }
  .dropdown::before {
    content: '';
    position: absolute;
    top: -12px;
    left: 0;
    right: 0;
    height: 12px;
  }
  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .dropdown-all {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--purple-light);
    padding: 0.5rem 0.75rem;
    border-radius: 5px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 4px;
    transition: background 0.15s;
  }
  .dropdown-all:hover { background: color-mix(in srgb, var(--purple) 10%, transparent); }

  .dropdown-item {
    font-size: 0.875rem;
    color: var(--text-muted);
    padding: 0.5rem 0.75rem;
    border-radius: 5px;
    transition: color 0.15s, background 0.15s;
  }
  .dropdown-item:hover { color: var(--white); background: var(--bg-4); }
  .dropdown-item--active { color: var(--white); }

  .nav-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.25rem;
  }
  .nav-socials { display: flex; align-items: center; gap: 0.75rem; }
  .social-link {
    color: var(--text-muted);
    display: flex;
    align-items: center;
    transition: color 0.25s ease, transform 0.25s ease;
  }
  .social-link:hover { color: var(--purple); transform: translateY(-2px); }
  .social-link[aria-label="WhatsApp"]:hover { color: #25D366; }
  .nav-cta {
    padding: 0.625rem 1.25rem;
    font-size: 0.875rem;
    white-space: nowrap;
    background: var(--purple);
    border: 1px solid var(--purple);
    transition: background 0.2s, border-color 0.2s, box-shadow 0.2s, transform 0.15s;
  }
  .nav-cta:hover {
    background: transparent;
    border-color: var(--purple);
    color: var(--purple) !important;
    box-shadow: 0 0 18px rgba(135, 80, 247, 0.35);
    transform: translateY(-1px);
  }
  .nav-cta-arrow { display: inline-block; transition: transform 0.2s; }
  .nav-cta:hover .nav-cta-arrow { transform: translateX(3px); }

  /* ── Hamburger ── */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    width: 36px;
    height: 36px;
    z-index: 300;
    position: relative;
  }
  .bar {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--white);
    border-radius: 2px;
    transform-origin: center;
  }

  /* ── Mobile overlay ── */
  .mob-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    opacity: 0;
    pointer-events: none;
  }

  .mob-panel {
    position: absolute;
    top: 0;
    right: 0;
    width: min(400px, 100vw);
    height: 100%;
    background: var(--bg-2);
    border-left: 1px solid var(--border-2);
    display: flex;
    flex-direction: column;
    padding: 5rem 2rem 2.5rem;
    overflow-y: auto;
    transform: translateX(100%);
    box-shadow: -20px 0 60px rgba(0,0,0,0.5);
  }

  .mob-close {
    position: absolute;
    top: 1.25rem;
    right: 1.5rem;
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s;
    border-radius: 6px;
  }
  .mob-close:hover { color: var(--white); }

  .mob-nav {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .mob-item {
    border-bottom: 1px solid var(--border);
    opacity: 0;
    transform: translateX(30px);
  }

  .mob-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 1rem 0;
    background: none;
    border: none;
    color: var(--text);
    font-size: 1.125rem;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    text-align: left;
    transition: color 0.2s;
    letter-spacing: -0.01em;
  }
  .mob-link:hover,
  .mob-link--active { color: var(--white); }

  .mob-chevron {
    transition: transform 0.3s ease;
    flex-shrink: 0;
    color: var(--text-muted);
  }
  .mob-services-btn[aria-expanded="true"] .mob-chevron { transform: rotate(180deg); }
  .mob-services-btn[aria-expanded="true"] { color: var(--white); }

  .mob-sub {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    background: var(--bg);
    border-radius: 8px;
    margin-bottom: 0;
    padding: 0 0.25rem;
  }
  .mob-sub.open { max-height: 500px; margin-bottom: 0.75rem; padding: 0.4rem 0.25rem; }

  .mob-sub-link {
    display: block;
    padding: 0.6rem 0.75rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
    transition: color 0.2s, background 0.2s;
    border-radius: 6px;
  }
  .mob-sub-link:first-child {
    color: var(--purple-light);
    font-weight: 600;
    font-size: 0.875rem;
  }
  .mob-sub-link:hover { color: var(--white); background: var(--bg-3); }

  .mob-footer {
    padding-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    opacity: 0;
    transform: translateY(20px);
  }

  .mob-cta {
    width: 100%;
    justify-content: center;
    font-size: 1rem;
    padding: 0.875rem;
  }

  .mob-socials {
    display: flex;
    gap: 1.25rem;
    justify-content: center;
  }
  .mob-social {
    color: var(--text-muted);
    display: flex;
    align-items: center;
    transition: color 0.2s, transform 0.2s;
  }
  .mob-social:hover { color: var(--purple); transform: translateY(-2px); }
  .mob-social[aria-label="WhatsApp"]:hover { color: #25D366; }

  /* ── Breakpoint ── */
  @media (max-width: 1100px) {
    .nav-inner {
      grid-template-columns: 1fr auto;
      gap: 1rem;
    }
    .nav-links, .nav-right { display: none; }
    .hamburger { display: flex; }
    .mob-overlay { display: block; }
  }
</style>

<script>
  import { gsap } from 'gsap';

  // ── Scroll blur ──────────────────────────────────────────
  const nav = document.getElementById('site-nav');
  if (nav) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        nav.style.background = 'rgba(12, 17, 21, 0.85)';
        nav.style.backdropFilter = 'blur(12px)';
        nav.style.boxShadow = '0 1px 24px rgba(0,0,0,0.4)';
        nav.style.borderBottomColor = 'rgba(27, 34, 39, 0.6)';
      } else {
        nav.style.background = 'var(--bg)';
        nav.style.backdropFilter = '';
        nav.style.boxShadow = '';
        nav.style.borderBottomColor = 'var(--border)';
      }
    }, { passive: true });
  }

  // ── Mobile overlay ───────────────────────────────────────
  const hamburger  = document.getElementById('hamburger-btn');
  const overlay    = document.getElementById('mob-overlay');
  const panel      = document.getElementById('mob-panel');
  const closeBtn   = document.getElementById('mob-close');
  const items      = document.querySelectorAll('[data-mob-item]');
  const footer     = document.querySelector('[data-mob-footer]');
  const bars       = document.querySelectorAll('.bar');

  let isOpen = false;
  let openTl: gsap.core.Timeline | null = null;

  function openMenu() {
    if (isOpen) return;
    isOpen = true;
    overlay!.style.pointerEvents = 'auto';
    overlay!.setAttribute('aria-hidden', 'false');
    overlay!.removeAttribute('inert');
    hamburger!.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';

    // Morph bars → X
    gsap.to(bars[0], { rotation: 45,  y: 7,  duration: 0.35, ease: 'power2.inOut' });
    gsap.to(bars[1], { scaleX: 0, opacity: 0, duration: 0.2,  ease: 'power2.in' });
    gsap.to(bars[2], { rotation: -45, y: -7, duration: 0.35, ease: 'power2.inOut' });

    openTl = gsap.timeline();
    openTl
      .to(overlay,  { opacity: 1, duration: 0.3, ease: 'power2.out' })
      .to(panel,    { x: 0,       duration: 0.45, ease: 'power3.out' }, '-=0.2')
      .to(items,    { x: 0, opacity: 1, duration: 0.4, stagger: 0.06, ease: 'power2.out' }, '-=0.2')
      .to(footer,   { y: 0, opacity: 1, duration: 0.35, ease: 'power2.out' }, '-=0.15');
  }

  function closeMenu() {
    if (!isOpen) return;
    isOpen = false;
    hamburger!.setAttribute('aria-expanded', 'false');

    // Restore bars
    gsap.to(bars[0], { rotation: 0, y: 0, duration: 0.3, ease: 'power2.inOut' });
    gsap.to(bars[1], { scaleX: 1, opacity: 1, duration: 0.25, ease: 'power2.out' });
    gsap.to(bars[2], { rotation: 0, y: 0, duration: 0.3, ease: 'power2.inOut' });

    gsap.timeline()
      .to([items, footer], { opacity: 0, duration: 0.15, ease: 'power2.in' })
      .to(panel,    { x: '100%',  duration: 0.35, ease: 'power3.in' }, '-=0.05')
      .to(overlay,  { opacity: 0, duration: 0.25, ease: 'power2.in' }, '-=0.2')
      .call(() => {
        overlay!.style.pointerEvents = 'none';
        overlay!.setAttribute('aria-hidden', 'true');
        overlay!.setAttribute('inert', '');
        document.body.style.overflow = '';
        // Reset for next open
        gsap.set(items,  { x: 30, opacity: 0 });
        gsap.set(footer, { y: 20, opacity: 0 });
      });
  }

  hamburger?.addEventListener('click', () => isOpen ? closeMenu() : openMenu());
  closeBtn?.addEventListener('click', closeMenu);

  // Close on backdrop click
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closeMenu();
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) closeMenu();
  });

  // Services accordion
  const servicesBtn = document.getElementById('mob-services-btn');
  const servicesSub = document.getElementById('mob-sub');
  servicesBtn?.addEventListener('click', () => {
    const expanded = servicesBtn.getAttribute('aria-expanded') === 'true';
    servicesBtn.setAttribute('aria-expanded', String(!expanded));
    servicesSub?.classList.toggle('open');
  });

  // Close on nav link click
  overlay?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', closeMenu);
  });
</script>
