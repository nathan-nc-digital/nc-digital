---
import '@fontsource/sora/400.css';
import '@fontsource/sora/600.css';
import '../styles/crm-workspace.css';
import AdminNav from './AdminNav.astro';
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>CRM | NC Digital</title>
  </head>
  <body class="workspace">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <aside class="sidebar">
      <a href="/admin/crm/" class="brand"><span class="brand-mark">NC</span><span>Digital<small>CLIENT WORKSPACE</small></span></a>
      <AdminNav variant="compact" />
      <p class="nav-label">YOUR WORKSPACE</p>
      <nav aria-label="CRM navigation">
        <a href="?view=today" data-view="today"><span aria-hidden="true">◷</span> Today</a>
        <a href="/admin/crm/inbox/"><span aria-hidden="true">✉</span> Inbox <small>Zoho</small></a>
        <a href="?view=opportunities" data-view="opportunities"><span aria-hidden="true">▥</span> Pipeline</a>
        <a href="?view=accounts" data-view="accounts"><span aria-hidden="true">♧</span> Customers</a>
        <a href="?view=contacts" data-view="contacts"><span aria-hidden="true">♙</span> Contacts</a>
        <a href="?view=quotes" data-view="quotes"><span aria-hidden="true">▤</span> Quotes</a>
        <a href="?view=services" data-view="services"><span aria-hidden="true">↻</span> Services</a>
        <a href="?view=reports" data-view="reports"><span aria-hidden="true">▧</span> Reports</a>
        <a href="?view=health" data-view="health"><span aria-hidden="true">◇</span> Mailbox health</a>
        <a href="?view=tasks" data-view="tasks"><span aria-hidden="true">✓</span> Tasks</a>
      </nav>
      <div class="sidebar-bottom"><div class="profile"><span>N</span><div>Nathan<small>Europe/London · GBP</small></div></div></div>
    </aside>
    <div class="workspace-main">
      <header class="topbar">
        <form id="global-search-form" role="search"><label for="global-search" class="sr-only">Search customers, contacts, enquiries, messages, notes, opportunities, tasks and quotes</label><input id="global-search" type="search" maxlength="120" placeholder="Search customers, contacts, enquiries and history…" autocomplete="off"/><kbd>Ctrl K</kbd></form>
        <div class="top-actions"><button id="refresh-workspace" class="quiet" type="button">Refresh</button><button id="quick-add" class="primary" type="button" aria-haspopup="dialog">＋ Add new</button></div>
      </header>
      <div id="workspace-notice" role="status" aria-live="polite" hidden></div>
      <main id="main-content" tabindex="-1"><div class="loading" role="status">Opening your workspace…</div></main>
      <footer class="workspace-footer">NC Digital <span>Every relationship. A clear next step.</span></footer>
    </div>
    <dialog id="editor" aria-labelledby="editor-title">
      <header class="dialog-header"><div><p id="editor-eyebrow" class="eyebrow">WORKSPACE</p><h2 id="editor-title"></h2></div><button id="close-editor" type="button" aria-label="Close dialog">×</button></header>
      <div id="editor-content"></div>
    </dialog>
    <script>import '../scripts/crm-workspace.js';</script>
  </body>
</html>
