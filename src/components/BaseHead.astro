---
export interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/og-default.png',
  canonical = Astro.url.href,
  noindex = false,
} = Astro.props;

function trimAtWord(value: string, maxLength: number) {
  if (value.length <= maxLength) return value;
  const trimmed = value.slice(0, maxLength - 3).replace(/\s+\S*$/, '').replace(/\s*[—–-]\s*$/, '').trim();
  return `${trimmed}...`;
}

const fullTitle = title.includes('NC Digital') ? title : `${title} | NC Digital`;
const unbrandedTitle = fullTitle.replace(/\s+\|\s+NC Digital$/, '');
const siteTitle = fullTitle.length > 70 ? trimAtWord(unbrandedTitle, 70) : fullTitle;
const metaDescription = trimAtWord(description, 155);
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{siteTitle}</title>
<meta name="description" content={metaDescription} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex,follow" />}

<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:image" content={new URL(image, Astro.site).href} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={siteTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={new URL(image, Astro.site).href} />

<link rel="preload" href="/fonts/sora-400.woff2" as="font" type="font/woff2" crossorigin />
<meta name="indexnow-verification" content="4c2616a9e08e4ce49f8a9f51d60b2228" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
<link rel="shortcut icon" href="/favicon.png" />

