---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const serviceOrder = [
  'web-design',
  'logo-design',
  'web-development',
  'managed-starter-websites',
  'local-seo-google-ranking',
  'website-hosting-security',
  'website-maintenance-packages',
];

const allServices = await getCollection('services');
const services = serviceOrder
  .map(id => allServices.find(s => s.id.replace('/index.mdoc', '') === id))
  .filter(Boolean);
---

<BaseLayout
  title="Web Design & SEO Services South Wales | NC Digital"
  description="Web design, local SEO, website maintenance, hosting, and professional email for South Wales small businesses. Based in Merthyr Tydfil."
>

  <section style="padding:5rem 0 3rem;">
    <div class="container site-pad" style="text-align:center;">
      <p data-animate="fade-up" class="eyebrow" style="margin-bottom:0.75rem;">What we offer</p>
      <h1 data-animate="fade-up" style="margin-bottom:1rem; max-width:820px; margin-left:auto; margin-right:auto;">Services built for South Wales businesses</h1>
      <p data-animate="fade-up" style="color:var(--text-muted); font-size:1.125rem; max-width:560px; line-height:1.7; margin:0 auto;">
        Everything your business needs to get online, get found, and grow — from a single agency in Merthyr Tydfil.
      </p>
    </div>
  </section>

  <section style="padding:3rem 0 5rem;">
    <div class="container site-pad">
      <div data-animate="stagger" class="svc-grid">
        {services.map((service) => (
          <a href={`/services/${service.id.replace('/index.mdoc', '')}/`} class="card svc-card" style="text-decoration:none;">
            <h2 class="svc-title">{service.data.title}</h2>
            <p class="svc-desc">{service.data.description}</p>
            <ul class="svc-features">
              {service.data.features.slice(0, 3).map((f: string) => (
                <li><span style="color:var(--purple);">✓</span> {f}</li>
              ))}
            </ul>
            <span class="svc-cta">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <style>
    .svc-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    .svc-card {
      display: flex;
      flex-direction: column;
    }

    .svc-title {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--white);
      margin: 0 0 0.75rem;
      min-height: 3.5rem;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .svc-desc {
      color: var(--text-muted);
      font-size: 0.9375rem;
      line-height: 1.6;
      margin: 0 0 1.25rem;
      min-height: 6rem;
      display: -webkit-box;
      -webkit-line-clamp: 4;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .svc-features {
      list-style: none;
      padding: 0;
      margin: 0 0 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
      flex: 1;
    }

    .svc-features li {
      font-size: 0.875rem;
      color: var(--text-muted);
      display: flex;
      gap: 0.5rem;
    }

    .svc-cta {
      color: var(--purple);
      font-size: 0.9375rem;
      font-weight: 600;
      margin-top: auto;
    }

    @media (max-width: 900px) {
      .svc-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 560px) {
      .svc-grid { grid-template-columns: 1fr; }
      .svc-title { min-height: 0; }
      .svc-desc  { min-height: 0; }
    }
  </style>

  <section style="padding:3rem 0 5rem; background:var(--bg-2); border-top:1px solid var(--border);">
    <div class="container site-pad">
      <p class="eyebrow" style="margin-bottom:0.75rem; text-align:center;">Where we work</p>
      <h2 style="text-align:center; margin-bottom:2.5rem; font-size:1.5rem;">Areas we serve</h2>
      <div style="display:flex; flex-wrap:wrap; gap:0.75rem; justify-content:center;">
        {[
          { href: '/web-design-cardiff/', label: 'Cardiff' },
          { href: '/web-design-merthyr-tydfil/', label: 'Merthyr Tydfil' },
          { href: '/web-design-swansea/', label: 'Swansea' },
          { href: '/web-design-newport/', label: 'Newport' },
          { href: '/web-design-bridgend/', label: 'Bridgend' },
          { href: '/web-design-pontypridd/', label: 'Pontypridd' },
          { href: '/web-design-aberdare/', label: 'Aberdare' },
          { href: '/web-design-llanelli/', label: 'Llanelli' },
          { href: '/web-design-caerphilly/', label: 'Caerphilly' },
          { href: '/web-design-south-wales/', label: 'South Wales' },
        ].map(({ href, label }) => (
          <a href={href} style="padding:0.5rem 1rem; border:1px solid var(--border); border-radius:6px; color:var(--text-muted); font-size:0.9375rem; transition:color 0.2s, border-color 0.2s, background 0.2s;" onmouseover="this.style.color='var(--white)';this.style.borderColor='var(--purple)';this.style.background='color-mix(in srgb,var(--purple) 8%,transparent)'" onmouseout="this.style.color='var(--text-muted)';this.style.borderColor='var(--border)';this.style.background='transparent'">
            {label}
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
