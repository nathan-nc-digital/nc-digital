---
import AdminNav from '../../components/AdminNav.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Google Indexing | NC Digital Admin</title>
    <style is:global>
      :root { color-scheme:dark; --bg:#090911; --panel:#11111c; --border:#25253a; --text:#f7f7fb; --muted:#a6a6bb; --purple:#8750f7; --green:#2dd77c; --red:#ff5c7a; --amber:#f6c85f; }
      * { box-sizing:border-box; }
      body { margin:0; background:var(--bg); color:var(--text); font-family:Sora,Inter,system-ui,sans-serif; }
      a { color:inherit; }
      .topbar { position:sticky; top:0; z-index:10; display:flex; justify-content:space-between; align-items:center; gap:1rem; padding:1rem 1.5rem; background:rgba(9,9,17,.94); border-bottom:1px solid var(--border); }
      .brand { font-weight:800; }
      .nav { display:flex; gap:.5rem; flex-wrap:wrap; }
      .nav a { text-decoration:none; color:var(--muted); border:1px solid var(--border); border-radius:8px; padding:.55rem .8rem; font-size:.82rem; font-weight:700; }
      .nav a.active { color:var(--text); background:var(--purple); border-color:var(--purple); }
      main { max-width:1320px; margin:0 auto; padding:2rem 1.5rem 4rem; }
      h1 { margin:0 0 .5rem; font-size:clamp(2rem,4vw,3.4rem); }
      .sub { color:var(--muted); line-height:1.6; margin:0; }
      .cmd { display:inline-block; margin-top:1rem; padding:.8rem 1rem; border:1px solid var(--border); border-radius:8px; background:var(--panel); color:var(--muted); font-family:ui-monospace,monospace; font-size:.8rem; }
      .stats { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:1rem; margin:1.5rem 0; }
      .stat { width:100%; padding:1rem; background:var(--panel); border:1px solid var(--border); border-radius:8px; color:inherit; text-align:left; font:inherit; }
      button.stat { cursor:pointer; }
      button.stat:hover { border-color:var(--purple); }
      .label { color:var(--muted); font-size:.75rem; text-transform:uppercase; font-weight:800; }
      .value { margin-top:.4rem; font-size:1.7rem; font-weight:900; }
      .filters { display:flex; gap:.75rem; margin:1.25rem 0; flex-wrap:wrap; }
      .filters input,.filters select { background:var(--panel); border:1px solid var(--border); color:var(--text); border-radius:8px; padding:.75rem .9rem; font:inherit; }
      .filters input { flex:1; min-width:min(360px,100%); }
      table { width:100%; border-collapse:collapse; background:var(--panel); border:1px solid var(--border); }
      th,td { padding:.8rem .9rem; border-bottom:1px solid var(--border); text-align:left; font-size:.84rem; vertical-align:top; }
      th { color:var(--muted); background:#0d0d16; font-size:.72rem; text-transform:uppercase; }
      .url { display:block; max-width:420px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
      .pill { display:inline-flex; border:1px solid var(--border); border-radius:999px; padding:.25rem .55rem; font-size:.7rem; font-weight:800; white-space:nowrap; }
      .indexed { color:var(--green); }
      .not-indexed { color:var(--red); }
      .unknown { color:var(--amber); }
      .muted { color:var(--muted); }
      @media(max-width:900px){
        .topbar { align-items:flex-start; padding:.75rem; }
        .brand { display:none; }
        .nav { width:100%; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.35rem; }
        .nav a { padding:.5rem .25rem; text-align:center; font-size:.68rem; }
        main { padding:1.25rem .75rem 3rem; }
        h1 { font-size:1.8rem; }
        .sub { font-size:.85rem; }
        .cmd { display:none; }
        .stats { grid-template-columns:repeat(2,minmax(0,1fr)); gap:.5rem; margin:1rem 0; }
        .stat { padding:.75rem; }
        .label { font-size:.62rem; }
        .value { font-size:1.35rem; }
        .filters { position:sticky; top:3.7rem; z-index:8; gap:.5rem; margin:1rem 0; padding:.5rem 0; background:var(--bg); }
        .filters input,.filters select { width:100%; min-width:0; padding:.7rem; font-size:.82rem; }
        table,tbody,tr,td { display:block; width:100%; }
        table { border:0; background:transparent; }
        thead { display:none; }
        tbody { display:grid; gap:.55rem; }
        tr {
          display:grid;
          grid-template-columns:minmax(0,1fr) auto;
          gap:.5rem .75rem;
          padding:.75rem;
          background:var(--panel);
          border:1px solid var(--border);
          border-radius:8px;
        }
        td {
          display:grid;
          grid-template-columns:5.5rem minmax(0,1fr);
          gap:.5rem;
          align-items:start;
          min-width:0;
          padding:.15rem 0;
          border:0;
          font-size:.76rem;
        }
        td::before {
          content:attr(data-label);
          color:var(--muted);
          font-size:.58rem;
          font-weight:800;
          text-transform:uppercase;
        }
        td:first-child { display:block; grid-column:1; padding:0; }
        td:first-child::before { display:none; }
        td:nth-child(2) { display:block; grid-column:2; grid-row:1; padding:0; }
        td:nth-child(2)::before { display:none; }
        td:nth-child(n+3) { grid-column:1 / -1; }
        .url { max-width:100%; font-size:.78rem; }
        td:first-child .url { color:var(--text); font-weight:800; }
        .pill { padding:.2rem .45rem; font-size:.62rem; }
      }
      .hero { display:flex; justify-content:space-between; align-items:flex-end; gap:1rem; margin-bottom:1rem; }
      .controls { display:grid; gap:.5rem; min-width:min(380px,100%); }
      .controls select, .controls button, .progress button { background:var(--panel); border:1px solid var(--border); color:var(--text); border-radius:8px; padding:.7rem .9rem; font:inherit; font-size:.85rem; width:100%; cursor:pointer; }
      .controls .primary { background:var(--purple); border-color:var(--purple); font-weight:800; }
      .controls button:disabled { opacity:.55; cursor:wait; }
      .buttons { display:grid; grid-template-columns:1fr 1fr; gap:.5rem; }
      .age { font-size:.78rem; color:var(--muted); }
      .age.stale { color:var(--amber); }
      .age.old { color:var(--red); }
      .stats { grid-template-columns:repeat(5,minmax(0,1fr)); }
      .notice { margin:1rem 0; padding:.8rem 1rem; border:1px solid var(--border); border-radius:8px; background:var(--panel); color:var(--muted); font-size:.88rem; }
      .notice.error { border-color:rgba(255,92,122,.5); color:#ffc2cd; }
      .progress { display:flex; align-items:center; gap:1rem; margin:1rem 0; padding:1rem; border:1px solid var(--purple); border-radius:8px; background:var(--panel); }
      .progress > div { flex:1; }
      .progress p { margin:0 0 .5rem; font-size:.88rem; }
      .progress button { width:auto; }
      .bar { height:6px; border-radius:99px; background:var(--border); overflow:hidden; }
      .bar span { display:block; height:100%; width:0; background:var(--purple); transition:width .3s; }
      .pending { color:var(--muted); }
      .advice { display:block; margin-top:.35rem; color:var(--muted); font-size:.78rem; line-height:1.5; }
      .small { display:block; margin-top:.25rem; font-size:.72rem; }
      .empty { padding:2rem; border:1px solid var(--border); border-radius:8px; background:var(--panel); color:var(--muted); }
      @media(max-width:900px){ tbody { grid-template-columns:minmax(0,1fr); } td { overflow-wrap:anywhere; } .hero { display:block; } .controls { margin-top:1rem; } .stats { grid-template-columns:repeat(2,minmax(0,1fr)); } .progress { display:block; } .progress button { margin-top:.5rem; } }
    </style>
  </head>
  <body>
<AdminNav />
    <header class="topbar">
      <div class="brand">Indexing</div>
    </header>
    <main>
      <section class="hero">
        <div>
          <h1>Google Indexing</h1>
          <p class="sub">Live Google URL Inspection results for every page in the sitemap, with a plain-English reason and fix for anything not indexed.</p>
        </div>
        <div class="controls">
          <select id="site" aria-label="Search Console property"><option>Loading properties…</option></select>
          <div class="buttons">
            <button id="check-problems" class="primary" type="button" title="Checks pages that are new, not indexed or had an error">Check new &amp; problem pages</button>
            <button id="check-all" type="button" title="Rechecks every page in the sitemap. Google allows 2,000 checks per day.">Check all pages</button>
          </div>
          <div id="age" class="age"></div>
        </div>
      </section>
      <div id="notice" class="notice" role="status" aria-live="polite" hidden></div>
      <section id="progress" class="progress" hidden>
        <div><p id="progress-copy"></p><div class="bar"><span id="progress-bar"></span></div></div>
        <button id="resume" type="button" hidden>Resume</button>
        <button id="stop" type="button">Stop</button>
      </section>

      <section class="stats" id="stats"></section>

      <div class="filters">
        <input id="search" type="search" placeholder="Search page URL or coverage reason" />
        <select id="status">
          <option value="">All index statuses</option>
          <option value="indexed">Indexed</option>
          <option value="not-indexed">Not indexed</option>
          <option value="stuck">Not indexed after 7+ days</option>
          <option value="pending">Not checked yet</option>
          <option value="unknown">Unknown / error</option>
        </select>
      </div>

      <table id="pages">
        <thead><tr><th>Page</th><th>Status</th><th>Google's reason &amp; what to do</th><th>Last crawl</th><th>Google canonical</th><th>Checked</th></tr></thead>
        <tbody id="rows"></tbody>
      </table>
      <p id="empty" class="empty" hidden>No pages checked for this property yet. Press <strong>Check new &amp; problem pages</strong> to read the sitemap and start.</p>
    </main>
    <script>import '../../scripts/indexing.js';</script>
  </body>
</html>
