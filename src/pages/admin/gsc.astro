---
import AdminNav from '../../components/AdminNav.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>GSC Insights | NC Digital Admin</title>
    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #090911;
        --panel: #11111c;
        --border: #25253a;
        --text: #f7f7fb;
        --muted: #a6a6bb;
        --purple: #8750f7;
        --green: #2dd77c;
        --red: #ff5c7a;
        --amber: #f6c85f;
        --blue: #60a5fa;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: Sora, Inter, system-ui, -apple-system, Segoe UI, sans-serif;
      }
      a { color: inherit; }
      .topbar {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.5rem;
        background: rgba(9, 9, 17, 0.94);
        border-bottom: 1px solid var(--border);
        backdrop-filter: blur(10px);
      }
      .brand { font-weight: 800; }
      .nav { display: flex; gap: 0.5rem; flex-wrap: wrap; }
      .nav a {
        text-decoration: none;
        color: var(--muted);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0.55rem 0.8rem;
        font-size: 0.82rem;
        font-weight: 700;
      }
      .nav a.active { color: var(--text); background: var(--purple); border-color: var(--purple); }
      main { max-width: 1400px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }
      .hero { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; margin-bottom: 1.5rem; }
      h1 { margin: 0 0 0.5rem; font-size: clamp(2rem, 4vw, 3.4rem); letter-spacing: -0.04em; }
      .sub { color: var(--muted); line-height: 1.6; margin: 0; max-width: 790px; }
      .cmd {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0.85rem 1rem;
        color: var(--muted);
        font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
        font-size: 0.8rem;
        white-space: nowrap;
      }
      .stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
        margin: 1.5rem 0;
      }
      .stat {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 1rem;
      }
      button.stat {
        width: 100%;
        color: inherit;
        font: inherit;
        text-align: left;
        cursor: pointer;
      }
      button.stat:hover, button.stat:focus-visible {
        border-color: var(--purple);
        background: #171728;
        outline: none;
      }
      .label { color: var(--muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 800; }
      .value { font-size: 1.7rem; font-weight: 900; margin-top: 0.4rem; letter-spacing: -0.03em; }
      .delta { margin-top: 0.3rem; color: var(--muted); font-size: 0.76rem; }
      .panel {
        margin: 1rem 0 1.5rem;
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
      }
      .panel-head {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem;
        border-bottom: 1px solid var(--border);
      }
      .panel-title { font-weight: 900; }
      .panel-note { color: var(--muted); font-size: 0.82rem; }
      .filters {
        display: flex;
        gap: 0.75rem;
        margin: 1.25rem 0;
        flex-wrap: wrap;
      }
      .filters input, .filters select, .filters button {
        background: var(--panel);
        border: 1px solid var(--border);
        color: var(--text);
        border-radius: 8px;
        padding: 0.75rem 0.9rem;
        font: inherit;
      }
      .filters input { min-width: min(360px, 100%); flex: 1; }
      .filters button { cursor: pointer; font-weight: 800; }
      .filters button:hover, .filters button:focus-visible { border-color: var(--purple); outline: none; }
      table { width: 100%; border-collapse: collapse; }
      th, td {
        padding: 0.8rem 0.9rem;
        border-bottom: 1px solid var(--border);
        text-align: left;
        vertical-align: top;
        font-size: 0.88rem;
      }
      tr:last-child td { border-bottom: 0; }
      th {
        background: #0d0d16;
        color: var(--muted);
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }
      .sort-button {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0;
        border: 0;
        background: transparent;
        color: inherit;
        font: inherit;
        font-weight: inherit;
        text-transform: inherit;
        letter-spacing: inherit;
        cursor: pointer;
        white-space: nowrap;
      }
      .sort-button::after { content: '↕'; color: #66667d; }
      .sort-button[data-direction="asc"]::after { content: '↑'; color: var(--purple); }
      .sort-button[data-direction="desc"]::after { content: '↓'; color: var(--purple); }
      .query { font-weight: 850; color: var(--text); }
      .url {
        display: block;
        color: var(--muted);
        font-size: 0.75rem;
        margin-top: 0.25rem;
        max-width: 440px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .pill {
        display: inline-flex;
        align-items: center;
        border: 1px solid var(--border);
        color: var(--muted);
        border-radius: 999px;
        padding: 0.25rem 0.55rem;
        font-size: 0.72rem;
        font-weight: 800;
        white-space: nowrap;
      }
      .pill.quick-win { color: var(--green); border-color: rgba(45, 215, 124, 0.35); }
      .pill.low-ctr { color: var(--amber); border-color: rgba(246, 200, 95, 0.35); }
      .pill.page-two-plus { color: var(--red); border-color: rgba(255, 92, 122, 0.35); }
      .pill.local { color: var(--blue); border-color: rgba(96, 165, 250, 0.35); }
      .pill.commercial { color: #c4b5fd; border-color: rgba(196, 181, 253, 0.35); }
      .pill.informational { color: var(--green); border-color: rgba(45, 215, 124, 0.35); }
      .num { font-variant-numeric: tabular-nums; font-weight: 800; }
      .muted { color: var(--muted); }
      .up { color: var(--green); }
      .down { color: var(--red); }
      .empty {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 2rem;
        color: var(--muted);
      }
      @media (max-width: 960px) {
        .topbar { align-items: flex-start; padding: 0.75rem; }
        .brand { display: none; }
        .nav { width: 100%; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.35rem; }
        .nav a { padding: 0.5rem 0.25rem; text-align: center; font-size: 0.62rem; }
        main { padding: 1.25rem 0.75rem 3rem; }
        .hero { display: block; }
        h1 { font-size: 1.8rem; }
        .sub { font-size: 0.85rem; }
        .cmd { display: none; }
        .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem; margin: 1rem 0; }
        .stat { padding: 0.75rem; }
        .label { font-size: 0.62rem; }
        .value { font-size: 1.35rem; }
        .filters { gap: 0.5rem; margin: 1rem 0; }
        .filters input, .filters select, .filters button { width: 100%; min-width: 0; padding: 0.7rem; font-size: 0.82rem; }
        .panel-head { display: block; }
        table, tbody, tr, td { display: block; width: 100%; }
        table { border: 0; background: transparent; }
        thead { display: none; }
        tbody { display: grid; gap: 0.6rem; padding: 0.75rem; }
        tr {
          display: grid;
          gap: 0.45rem;
          padding: 0.75rem;
          background: #0d0d16;
          border: 1px solid var(--border);
          border-radius: 8px;
        }
        td {
          display: grid;
          grid-template-columns: 5.5rem minmax(0, 1fr);
          gap: 0.5rem;
          align-items: start;
          min-width: 0;
          padding: 0.15rem 0;
          border: 0;
          font-size: 0.76rem;
        }
        td::before {
          content: attr(data-label);
          color: var(--muted);
          font-size: 0.58rem;
          font-weight: 800;
          text-transform: uppercase;
        }
        td:first-child { display: block; padding: 0; }
        td:first-child::before { display: none; }
        .url { max-width: 100%; white-space: normal; overflow-wrap: anywhere; }
      }
      .controls { display:grid; gap:.5rem; justify-items:end; min-width:min(360px,100%); }
      .controls select, .refresh { background:var(--panel); border:1px solid var(--border); color:var(--text); border-radius:8px; padding:.7rem .9rem; font:inherit; font-size:.85rem; width:100%; }
      .refresh { cursor:pointer; font-weight:800; background:var(--purple); border-color:var(--purple); }
      .refresh:disabled { opacity:.6; cursor:wait; }
      .age { font-size:.78rem; color:var(--muted); }
      .age.stale { color:var(--amber); }
      .age.old { color:var(--red); }
      .notice { margin:1rem 0; padding:.8rem 1rem; border:1px solid var(--border); border-radius:8px; background:var(--panel); color:var(--muted); font-size:.88rem; }
      .notice.error { border-color:rgba(255,92,122,.5); color:#ffc2cd; }
      .since-chips { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.75rem; padding:1rem; }
      .since-chip { display:grid; gap:.2rem; padding:.8rem; border:1px solid var(--border); border-radius:8px; background:#0d0d16; }
      .since-chip span { color:var(--muted); font-size:.7rem; font-weight:800; text-transform:uppercase; letter-spacing:.06em; }
      .since-chip strong { font-size:1rem; }
      .since-chip em { font-style:normal; font-size:.78rem; color:var(--muted); }
      .since-chip.good em { color:var(--green); }
      .since-chip.bad em { color:var(--red); }
      .since-cols { display:grid; grid-template-columns:1fr 1fr; gap:1rem; padding:0 1rem 1rem; }
      .since-col { border:1px solid var(--border); border-radius:8px; padding:1rem; background:#0d0d16; min-width:0; }
      .since-col.good { border-color:rgba(45,215,124,.3); }
      .since-col.bad { border-color:rgba(255,92,122,.3); }
      .since-col h3 { margin:0 0 .5rem; font-size:1rem; }
      .since-col.good h3 { color:var(--green); }
      .since-col.bad h3 { color:var(--red); }
      .since-col h4 { margin:1rem 0 .4rem; font-size:.72rem; color:var(--muted); text-transform:uppercase; letter-spacing:.06em; }
      .since-list { list-style:none; margin:0; padding:0; display:block !important; }
      .since-list li { display:flex !important; justify-content:space-between; align-items:center; gap:.75rem; padding:.5rem 0; border-bottom:1px solid var(--border); font-size:.84rem; }
      .since-list li:last-child { border-bottom:0; }
      .since-list li > span:first-child { min-width:0; overflow-wrap:anywhere; }
      .since-list small { display:block; color:var(--muted); font-size:.72rem; margin-top:.15rem; }
      .since-tag { flex:none; font-size:.72rem; font-weight:800; padding:.2rem .5rem; border-radius:999px; border:1px solid var(--border); white-space:nowrap; }
      .since-tag.good { color:var(--green); border-color:rgba(45,215,124,.35); }
      .since-tag.bad { color:var(--red); border-color:rgba(255,92,122,.35); }
      .since-none { margin:.25rem 0; color:var(--muted); font-size:.82rem; }
      .since > .since-none { padding:0 1rem 1rem; }
      .panel-empty { margin:0; padding:1rem; color:var(--muted); font-size:.88rem; }
      @media (max-width: 960px) { .since-chips { grid-template-columns:repeat(2,minmax(0,1fr)); padding:.75rem; } .since-cols { grid-template-columns:1fr; padding:0 .75rem .75rem; } .controls { justify-items:stretch; margin-top:1rem; } }
    </style>
  </head>
  <body>
<AdminNav />
    <header class="topbar">
      <div class="brand">Search Console</div>
    </header>

    <main>
      <section class="hero">
        <div>
          <h1>GSC Insights</h1>
          <p class="sub">
            Live Google Search Console clicks, impressions, CTR, position, query/page pairings and suggested next actions for any property you manage. Data refreshes automatically when it is more than 12 hours old.
          </p>
        </div>
        <div class="controls">
          <select id="site" aria-label="Search Console property"><option>Loading properties…</option></select>
          <button id="refresh" class="refresh" type="button">Refresh from Google</button>
          <div id="age" class="age"></div>
        </div>
      </section>
      <div id="notice" class="notice" role="status" aria-live="polite" hidden></div>
      <div id="out"><div class="empty">Loading…</div></div>
    </main>
    <script>import '../../scripts/gsc-insights.js';</script>
  </body>
</html>
