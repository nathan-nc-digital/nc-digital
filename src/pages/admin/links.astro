---
import { readFileSync, readdirSync, statSync } from 'node:fs';
import { join, sep } from 'node:path';
import { BLOG_CATEGORY_META } from '../../data/blogCategories';

// ── Types ──────────────────────────────────────────────────────────────────
type PageType = 'service' | 'location' | 'blog' | 'portfolio' | 'page';
interface LinkRef { url: string; anchor: string; }
interface PageData {
  url: string; title: string; type: PageType; category?: string; location?: string; locations?: string[]; town?: string;
  inbound: LinkRef[]; outbound: LinkRef[]; inSitewide: boolean; isPillar?: boolean;
}

const PORTFOLIO_LOCATION_META: Record<string, { label: string; color: string }> = {
  'merthyr-tydfil': { label: 'Merthyr Tydfil', color: '#0891b2' },
  'caerphilly':     { label: 'Caerphilly',     color: '#7c3aed' },
};

const BLOG_LOCATION_META: Record<string, { label: string; color: string }> = {
  'south-wales':    { label: 'South Wales',    color: '#7c3aed' },
  'merthyr-tydfil': { label: 'Merthyr Tydfil', color: '#0891b2' },
  'cardiff':        { label: 'Cardiff',        color: '#2563eb' },
  'swansea':        { label: 'Swansea',        color: '#0d9488' },
  'newport':        { label: 'Newport',        color: '#d97706' },
  'bridgend':       { label: 'Bridgend',       color: '#9333ea' },
  'pontypridd':     { label: 'Pontypridd',     color: '#db2777' },
  'caerphilly':     { label: 'Caerphilly',     color: '#059669' },
  'aberdare':       { label: 'Aberdare',       color: '#dc2626' },
  'rhondda':        { label: 'Rhondda',        color: '#be185d' },
  'barry':          { label: 'Barry',          color: '#0891b2' },
  'neath':          { label: 'Neath',          color: '#b45309' },
  'port-talbot':    { label: 'Port Talbot',    color: '#065f46' },
  'cwmbran':        { label: 'Cwmbran',        color: '#1d4ed8' },
  'llanelli':       { label: 'Llanelli',       color: '#9d174d' },
};

// ── Helpers ────────────────────────────────────────────────────────────────
const ROOT = process.cwd();
const unix = (p: string) => p.split(sep).join('/');

function norm(url: string): string {
  url = url.split('?')[0].split('#')[0];
  if (!url.startsWith('/')) return '';
  if (url === '/') return '/';
  return url.endsWith('/') ? url : url + '/';
}

function walk(dir: string, ext: string): string[] {
  const out: string[] = [];
  try {
    for (const e of readdirSync(dir)) {
      const p = join(dir, e);
      statSync(p).isDirectory() ? out.push(...walk(p, ext)) : p.endsWith(ext) && out.push(p);
    }
  } catch {}
  return out;
}

function fileToUrl(fp: string): string | null {
  const r = unix(fp).replace(unix(ROOT) + '/', '');
  let m: RegExpMatchArray | null;
  if ((m = r.match(/^src\/content\/blog\/(.+?)\/index\.mdoc$/)))      return `/blog/${m[1]}/`;
  if ((m = r.match(/^src\/content\/locations\/(.+?)\/index\.mdoc$/))) return `/${m[1]}/`;
  if ((m = r.match(/^src\/content\/services\/(.+?)\/index\.mdoc$/)))  return `/services/${m[1]}/`;
  if ((m = r.match(/^src\/content\/portfolio\/(.+?)\/index\.mdoc$/))) return `/portfolio/${m[1]}/`;
  const pages: Record<string, string> = {
    'src/pages/index.astro':                '/',
    'src/pages/about.astro':                '/about/',
    'src/pages/contact.astro':              '/contact/',
    'src/pages/free-website-plan.astro':    '/free-website-plan/',
    'src/pages/privacy-policy.astro':       '/privacy-policy/',
    'src/pages/services/index.astro':       '/services/',
    'src/pages/portfolio/index.astro':      '/portfolio/',
    'src/pages/blog/[...page].astro':       '/blog/',
  };
  return pages[r] ?? null;
}

function getType(fp: string): PageType {
  const u = unix(fp);
  if (u.includes('/content/blog/'))      return 'blog';
  if (u.includes('/content/locations/')) return 'location';
  if (u.includes('/content/services/'))  return 'service';
  if (u.includes('/content/portfolio/')) return 'portfolio';
  return 'page';
}

function getTitle(content: string): string {
  const fm = content.match(/^title:\s*["']?(.+?)["']?\s*$/m);
  if (fm) return fm[1].trim();
  const h = content.match(/^#{1,2}\s+(.+)$/m);
  return h ? h[1].trim() : 'Untitled';
}

function getCategory(content: string): string | undefined {
  const m = content.match(/^category:\s*["']?(.+?)["']?\s*$/m);
  return m ? m[1].trim() : undefined;
}

function getLocation(content: string): string | undefined {
  const m = content.match(/^location:\s*["']?(.+?)["']?\s*$/m);
  return m ? m[1].trim() : undefined;
}

function getTown(content: string): string | undefined {
  const m = content.match(/^town:\s*["']?(.+?)["']?\s*$/m);
  return m ? m[1].trim() : undefined;
}

function getLocations(content: string): string[] {
  // YAML block array: location:\n  - val
  const block = content.match(/^location:\s*\n((?:[ \t]+-[ \t]+.+\n?)+)/m);
  if (block) {
    return (block[1].match(/-[ \t]+(.+)/g) ?? []).map(s => s.replace(/^-[ \t]+/, '').trim());
  }
  // Inline array: location: [val1, val2]
  const inline = content.match(/^location:\s*\[([^\]]+)\]/m);
  if (inline) {
    return inline[1].split(',').map(s => s.trim().replace(/^["']|["']$/g, ''));
  }
  return [];
}

function mdocLinks(content: string): LinkRef[] {
  const body = content.replace(/^---[\s\S]*?---\n?/, '');
  const out: LinkRef[] = [];
  const re = /\[([^\]]*)\]\((\/[^)"'\s]*)/g;
  let m;
  while ((m = re.exec(body)) !== null) {
    const url = norm(m[2]);
    if (url) out.push({ url, anchor: m[1] });
  }
  return out;
}

function astroLinks(content: string): LinkRef[] {
  const out: LinkRef[] = [];
  let m;
  const re1 = /href=["'](\/[^"'#?]*)/g;
  const re2 = /href=\{[`"'](\/[^`"'#?]*)/g;
  while ((m = re1.exec(content)) !== null) { const u = norm(m[1]); if (u) out.push({ url: u, anchor: '' }); }
  while ((m = re2.exec(content)) !== null) { const u = norm(m[1]); if (u) out.push({ url: u, anchor: '' }); }
  return out;
}

// ── Build map ──────────────────────────────────────────────────────────────
const map = new Map<string, PageData>();

const contentFiles = walk(join(ROOT, 'src/content'), '.mdoc');
const staticPages   = [
  'src/pages/index.astro', 'src/pages/about.astro', 'src/pages/contact.astro',
  'src/pages/free-website-plan.astro', 'src/pages/privacy-policy.astro',
  'src/pages/services/index.astro', 'src/pages/portfolio/index.astro',
  'src/pages/blog/[...page].astro',
].map(f => join(ROOT, f));
const sitewideFiles = [
  join(ROOT, 'src/components/Footer.astro'),
  join(ROOT, 'src/components/Nav.astro'),
];

// Pass 1 — register pages
for (const fp of [...contentFiles, ...staticPages]) {
  const url = fileToUrl(fp);
  if (!url || map.has(url)) continue;
  const content = readFileSync(fp, 'utf-8');
  const type = getType(fp);
  const category  = type === 'blog'      ? getCategory(content)  : undefined;
  const location  = type === 'portfolio' ? getLocation(content)  : undefined;
  const locations = type === 'blog'      ? getLocations(content) : undefined;
  const town      = type === 'location'  ? getTown(content)      : undefined;
  const isPillar  = type === 'location' && url.startsWith('/web-agency-') ? true : undefined;
  map.set(url, { url, title: getTitle(content), type, category, location, locations, town, isPillar, inbound: [], outbound: [], inSitewide: false });
}

// Pass 2 — extract editorial links
for (const fp of [...contentFiles, ...staticPages]) {
  const fromUrl = fileToUrl(fp);
  if (!fromUrl) continue;
  const content = readFileSync(fp, 'utf-8');
  const links = fp.endsWith('.mdoc') ? mdocLinks(content) : astroLinks(content);
  const fromData = map.get(fromUrl)!;
  const seenOut = new Set<string>();
  const seenIn  = new Set<string>();

  for (const link of links) {
    const to = link.url;
    if (!map.has(to) || to === fromUrl) continue;
    if (!seenOut.has(to)) { fromData.outbound.push(link); seenOut.add(to); }
    if (!seenIn.has(to))  { map.get(to)!.inbound.push({ url: fromUrl, anchor: link.anchor }); seenIn.add(to); }
  }
}

// Pass 3 — sitewide flags
for (const fp of sitewideFiles) {
  const content = readFileSync(fp, 'utf-8');
  for (const link of astroLinks(content)) {
    if (map.has(link.url)) map.get(link.url)!.inSitewide = true;
  }
}

// ── Sort & stats ───────────────────────────────────────────────────────────
const ORDER: Record<PageType, number> = { service: 0, location: 1, portfolio: 2, page: 3, blog: 4 };
const pages = [...map.values()].sort((a, b) =>
  a.type !== b.type ? ORDER[a.type] - ORDER[b.type] : a.inbound.length - b.inbound.length
);

const moneyPages  = pages.filter(p => p.type === 'service' || p.type === 'location');
const avgInbound  = moneyPages.length
  ? Math.round(moneyPages.reduce((s, p) => s + p.inbound.length, 0) / moneyPages.length) : 0;
const underlinked = moneyPages.filter(p => p.inbound.length < 5).length;
const zeroLinked  = moneyPages.filter(p => p.inbound.length === 0).length;

const TYPE_COLOR: Record<PageType, string> = {
  service:   '#7c3aed', location: '#2563eb', blog:      '#059669',
  portfolio: '#d97706', page:     '#6b7280',
};

function inClass(p: PageData): string {
  if (p.type !== 'service' && p.type !== 'location') return 'neutral';
  const n = p.inbound.length;
  if (n === 0) return 'red';
  if (n < 5)   return 'amber';
  return 'green';
}

// Blog category counts
const blogCategoryCounts: Record<string, number> = {};
for (const p of pages) {
  if (p.type === 'blog' && p.category) {
    blogCategoryCounts[p.category] = (blogCategoryCounts[p.category] ?? 0) + 1;
  }
}

// Portfolio location counts
const portfolioLocationCounts: Record<string, number> = {};
for (const p of pages) {
  if (p.type === 'portfolio' && p.location) {
    portfolioLocationCounts[p.location] = (portfolioLocationCounts[p.location] ?? 0) + 1;
  }
}

// Blog location counts
const blogLocationCounts: Record<string, number> = {};
for (const p of pages) {
  if (p.type === 'blog' && p.locations?.length) {
    for (const loc of p.locations) {
      blogLocationCounts[loc] = (blogLocationCounts[loc] ?? 0) + 1;
    }
  }
}

// Location page town counts
const locationTownCounts: Record<string, number> = {};
for (const p of pages) {
  if (p.type === 'location' && p.town) {
    locationTownCounts[p.town] = (locationTownCounts[p.town] ?? 0) + 1;
  }
}
const TOWN_COLORS: Record<string, string> = {
  'Merthyr Tydfil': '#0891b2', 'Cardiff': '#2563eb', 'Swansea': '#0d9488',
  'Newport': '#d97706', 'Bridgend': '#9333ea', 'Pontypridd': '#db2777',
  'Caerphilly': '#059669', 'Aberdare': '#dc2626', 'Rhondda': '#be185d',
  'Barry': '#0891b2', 'Neath': '#b45309', 'Port Talbot': '#065f46',
  'Cwmbran': '#1d4ed8', 'Llanelli': '#9d174d', 'Penarth': '#7c3aed',
  'Vale of Glamorgan': '#0f766e', 'Ebbw Vale': '#6d28d9', 'South Wales': '#475569',
  'Mid Wales': '#64748b', 'North Wales': '#94a3b8', 'Wales': '#6b7280',
  'Wrexham': '#854d0e',
  'Bangor': '#0e7490', 'Rhyl': '#b91c1c', 'Llandudno': '#0369a1',
  'Caernarfon': '#15803d', 'Holyhead': '#6b21a8', 'Colwyn Bay': '#c2410c',
  'Aberystwyth': '#0891b2', 'Newtown': '#16a34a', 'Welshpool': '#ca8a04',
  'Llandrindod Wells': '#7c3aed', 'Brecon': '#dc2626', 'Machynlleth': '#0d9488',
  'Mold': '#1d4ed8', 'Flint': '#9333ea', 'Buckley': '#b45309',
  'Holywell': '#0f766e', 'Ruthin': '#be185d', 'Denbigh': '#6d28d9',
  'East Wales': '#475569',
  'West Wales': '#0369a1',
  'Haverfordwest': '#2563eb', 'Pembroke': '#0891b2', 'Tenby': '#0d9488',
  'Fishguard': '#7c3aed', 'Carmarthen': '#db2777', 'Cardigan': '#d97706',
  'Milford Haven': '#0f766e', 'Pembroke Dock': '#1d4ed8', 'Ammanford': '#dc2626', 'Llandeilo': '#6d28d9',
  'Chepstow': '#0891b2', 'Porthcawl': '#7c3aed', 'Blackwood': '#16a34a', 'Bargoed': '#b91c1c',
  'Tredegar': '#d97706', 'Prestatyn': '#0369a1', 'Conwy': '#15803d', 'Pwllheli': '#9333ea',
  'Porthmadog': '#be185d', 'Dolgellau': '#854d0e',
  'Builth Wells': '#ca8a04', 'Hay-on-Wye': '#065f46',
};
const townsSorted = Object.keys(locationTownCounts).sort((a, b) =>
  locationTownCounts[b] - locationTownCounts[a]
);

// Ahrefs backlink data keyed by page path
import { existsSync } from 'node:fs';
const AHREFS_CACHE = join(ROOT, 'scripts/ahrefs-cache.json');
const ahrefsBacklinks: Record<string, { anchor: string; url_from: string; dr: number; dofollow: boolean; first_seen: string }[]> = {};
if (existsSync(AHREFS_CACHE)) {
  try {
    const raw = JSON.parse(readFileSync(AHREFS_CACHE, 'utf-8'));
    for (const b of (raw.backlinks ?? [])) {
      const path = b.url_to.replace(/^https?:\/\/nc-digital\.co\.uk/, '') || '/';
      const key  = path.endsWith('/') ? path : path + '/';
      (ahrefsBacklinks[key] = ahrefsBacklinks[key] ?? []).push({
        anchor:     b.anchor || '',
        url_from:   b.url_from,
        dr:         b.domain_rating_source ?? 0,
        dofollow:   b.is_dofollow ?? false,
        first_seen: b.first_seen ?? '',
      });
    }
  } catch {}
}

// Client-side data for detail panel
const clientData = Object.fromEntries(
  pages.map(p => [p.url, {
    title: p.title,
    type: p.type,
    category: p.category,
    location: p.location,
    inbound: p.inbound,
    outbound: p.outbound,
    inSitewide: p.inSitewide,
    backlinks: ahrefsBacklinks[p.url] ?? [],
  }])
);
