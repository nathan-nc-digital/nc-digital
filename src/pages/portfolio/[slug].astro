---
import { portfolioFolders } from '../../data/portfolio-folders';
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLD from '../../components/JsonLD.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

export const prerender = true;

export async function getStaticPaths() {
  const projects = await getCollection('portfolio');
  return projects.map((project) => ({
    params: { slug: project.id.replace('/index.mdoc', '') },
    props: { project },
  }));
}

const { project } = Astro.props;
if (!project) return Astro.redirect('/portfolio/');

const { Content } = await render(project);
const slug = project.id.replace('/index.mdoc', '');

// Map slug → subfolder name
const folderMap = portfolioFolders;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/portfolio/**/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG}',
  { eager: true }
);

const folder = folderMap[slug] || '';
const isMilne = slug === 'milne-industrial';
const milneImageAlts = [
  'Milne Industrial opening banner displayed on a desktop monitor',
  'Milne Industrial services section displayed on a laptop',
  'Milne Industrial company introduction displayed on a mobile phone',
  'Milne Industrial global operations displayed on desktop and mobile',
];
const galleryImages = Object.entries(allImages)
  .filter(([path]) => {
    if (!folder || !path.includes(`/${folder}/`)) return false;
    const filename = path.split('/').pop() || '';
    return !filename.toLowerCase().startsWith('whatsapp');
  })
  .map(([, mod]) => mod.default)
  .slice(0, 4);

function getThumb(s: string): ImageMetadata | null {
  const f = folderMap[s];
  if (!f) return null;
  const match = Object.entries(allImages).find(([path]) => {
    if (!path.includes(`/${f}/`)) return false;
    return !path.split('/').pop()!.toLowerCase().startsWith('whatsapp');
  });
  return match ? match[1].default : null;
}

const allProjects = await getCollection('portfolio');
const relatedProjects = allProjects
  .filter(p => p.id.replace('/index.mdoc', '') !== slug)
  .slice(0, 3);

const serviceLabels: Record<string, string> = {
  'web-design':       'Web Design',
  'web-development':  'Web Development',
  'seo':              'Local SEO',
  'local-seo':        'Local SEO',
  'hosting':                   'Hosting & Security',
  'email':                     'Business Email',
  'managed-starter-websites':  'Managed Starter Websites',
};

const serviceLinks: Record<string, string> = {
  'web-design':                '/services/web-design/',
  'web-development':           '/services/web-development/',
  'seo':                       '/services/local-seo-google-ranking/',
  'local-seo':                 '/services/local-seo-google-ranking/',
  'hosting':                   '/services/website-hosting-security/',
  'managed-starter-websites':  '/services/managed-starter-websites/',
};
---

<BaseLayout
  title={project.data.metaTitle || `${project.data.title} | NC Digital Portfolio`}
  description={project.data.metaDescription || project.data.summary}
>

  <JsonLD schema={{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://nc-digital.co.uk/" },
      { "@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://nc-digital.co.uk/portfolio/" },
      { "@type": "ListItem", "position": 3, "name": project.data.title, "item": Astro.url.href }
    ]
  }} />

  <!-- Hero: text left, gallery right -->
  <section class="case-hero">
    <div class="container site-pad">
      <div class="hero-grid">

        <!-- Left: text -->
        <div class="hero-text">
          <a href="/portfolio/" class="back-link">← All case studies</a>
          <p data-animate="fade-up" class="eyebrow" style="margin-bottom:0.75rem;">Case study</p>
          <h1 data-animate="fade-up" style="margin-bottom:1rem; line-height:1.15;">{project.data.title}</h1>
          <p data-animate="fade-up" style="color:var(--text-muted); font-size:1.0625rem; line-height:1.75; margin-bottom:1.5rem;">
            {project.data.summary}
          </p>

          <div data-animate="fade-up" style="display:flex; flex-wrap:wrap; gap:0.375rem; margin-bottom:2rem;">
            {project.data.services.map((s: string) => (
              <a href={serviceLinks[s] || '/services/'} class="service-tag">
                {serviceLabels[s] || s}
              </a>
            ))}
          </div>

          <div data-animate="fade-up" style="display:flex; flex-wrap:wrap; align-items:center; gap:0.75rem;">
            <a href="/contact/" class="btn-primary">Start your project →</a>
            {project.data.siteUrl && (
              <a href={project.data.siteUrl} target="_blank" class="btn-outline" style="font-size:0.875rem;">
                Visit website ↗
              </a>
            )}
          </div>
        </div>

        <!-- Right: gallery -->
        {galleryImages.length > 0 && (
          <div data-animate="fade-up" class:list={['hero-gallery', { 'portrait-gallery': isMilne }]}>
            <!-- Featured image -->
            <div class="gallery-featured lb-trigger">
              <Image
                src={galleryImages[0]}
                alt={isMilne ? milneImageAlts[0] : `${project.data.title} — screenshot 1`}
                width={800}
                height={isMilne ? Math.round(800 * galleryImages[0].height / galleryImages[0].width) : 500}
                class="gallery-img"
              />
              <span class="lb-hint">Click to enlarge</span>
            </div>

            <!-- Thumbnails -->
            {galleryImages.length > 1 && (
              <div class="gallery-thumbs">
                {galleryImages.slice(1, 4).map((img, i) => (
                  <div class="gallery-thumb lb-trigger">
                    <Image
                      src={img}
                      alt={isMilne ? milneImageAlts[i + 1] : `${project.data.title} — screenshot ${i + 2}`}
                      width={400}
                      height={isMilne ? Math.round(400 * img.height / img.width) : 260}
                      class="gallery-img"
                    />
                  </div>
                ))}
              </div>
            )}
          </div>
        )}

      </div>
    </div>
  </section>

  <!-- Lightbox overlay -->
  <div id="lb-overlay" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Image viewer">
    <button id="lb-close" aria-label="Close image viewer">✕</button>
    <button id="lb-prev" aria-label="Previous image">&#8249;</button>
    <img id="lb-img" src="" alt="Portfolio image" />
    <button id="lb-next" aria-label="Next image">&#8250;</button>
    <div id="lb-counter"></div>
  </div>

  <!-- Case study content -->
  <section style="padding:4rem 0 5rem;">
    <div class="container site-pad layout-sidebar">

      <div data-animate={isMilne ? undefined : 'fade-up'} class="prose">
        <Content />
      </div>

      <aside>
        <div data-animate="fade-in" class="card" style="position:sticky; top:calc(72px + 2rem);">
          <h3 style="font-size:1rem; font-weight:700; color:var(--white); margin-bottom:1rem;">Project details</h3>
          <dl style="margin:0; display:flex; flex-direction:column; gap:0.875rem;">
            <div>
              <dt style="font-size:0.75rem; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.08em; margin-bottom:0.3rem;">Client</dt>
              <dd style="font-size:0.9375rem; color:var(--white); margin:0; font-weight:500;">{project.data.client}</dd>
            </div>
            <div>
              <dt style="font-size:0.75rem; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.08em; margin-bottom:0.3rem;">Services</dt>
              <dd style="margin:0; display:flex; flex-wrap:wrap; gap:0.375rem;">
                {project.data.services.map((s: string) => (
                  <a href={serviceLinks[s] || '/services/'} style="font-size:0.8125rem; color:var(--purple); background:color-mix(in srgb, var(--purple) 10%, transparent); border:1px solid color-mix(in srgb, var(--purple) 30%, transparent); border-radius:4px; padding:0.2rem 0.6rem; text-decoration:none; transition:border-color 0.2s;">
                    {serviceLabels[s] || s}
                  </a>
                ))}
              </dd>
            </div>
          </dl>
          <div style="margin-top:1.5rem; padding-top:1.5rem; border-top:1px solid var(--border);">
            <a href="/free-website-plan/" class="btn-primary" style="width:100%; justify-content:center;">Get a free plan →</a>
          </div>
          <div style="margin-top:1.25rem; padding-top:1.25rem; border-top:1px solid var(--border);">
            <p style="font-size:0.75rem; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:var(--purple); margin-bottom:0.625rem;">More case studies</p>
            <a href="/portfolio/" style="color:var(--text-muted); font-size:0.875rem; transition:color 0.2s;" onmouseover="this.style.color='var(--white)'" onmouseout="this.style.color='var(--text-muted)'">View all projects →</a>
          </div>
        </div>
      </aside>

    </div>
  </section>

  <!-- More projects -->
  {relatedProjects.length > 0 && (
    <section style="padding:4rem 0 5rem;">
      <div class="container site-pad">
        <p class="eyebrow" style="margin-bottom:0.75rem;">More work</p>
        <h2 style="margin-bottom:2rem; font-size:1.625rem;">More projects</h2>
        <div class="related-grid">
          {relatedProjects.map(p => {
            const rSlug = p.id.replace('/index.mdoc', '');
            const thumb = getThumb(rSlug);
            return (
              <a href={`/portfolio/${rSlug}/`} class="related-card">
                <div class="related-img-wrap">
                  {thumb ? (
                    <Image src={thumb} alt={p.data.title} width={480} height={300} class="related-img" />
                  ) : (
                    <div class="related-img-placeholder"><span>{p.data.title}</span></div>
                  )}
                </div>
                <div class="related-body">
                  <h3 class="related-title">{p.data.title}</h3>
                  <p class="related-summary">{p.data.summary}</p>
                  <span class="related-cta">View case study →</span>
                </div>
              </a>
            );
          })}
        </div>
        <div style="margin-top:2.5rem; text-align:center;">
          <a href="/portfolio/" class="btn-outline">View all projects →</a>
        </div>
      </div>
    </section>
  )}

  <style>
    .case-hero {
      padding: 3.5rem 0 4rem;
      position: relative;
      overflow: hidden;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
    }

    .hero-text {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      color: var(--text-muted);
      font-size: 0.875rem;
      margin-bottom: 1.5rem;
      text-decoration: none;
      transition: color 0.2s;
    }
    .back-link:hover { color: var(--text); }

    .service-tag {
      font-size: 0.8125rem;
      font-weight: 500;
      color: var(--purple);
      background: color-mix(in srgb, var(--purple) 10%, transparent);
      border: 1px solid color-mix(in srgb, var(--purple) 30%, transparent);
      border-radius: 4px;
      padding: 0.25rem 0.625rem;
      text-decoration: none;
      transition: background 0.2s, border-color 0.2s;
    }
    .service-tag:hover {
      background: color-mix(in srgb, var(--purple) 20%, transparent);
      border-color: var(--purple);
      color: var(--purple-light);
    }

    /* Gallery */
    .hero-gallery {
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
    }

    .gallery-featured {
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid var(--border);
      line-height: 0;
    }

    .gallery-thumbs {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.625rem;
    }

    .gallery-thumb {
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid var(--border);
      line-height: 0;
    }

    .gallery-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.3s ease;
    }

    .gallery-featured:hover .gallery-img,
    .gallery-thumb:hover .gallery-img {
      transform: scale(1.02);
    }

    .gallery-featured .gallery-img {
      max-height: 340px;
    }

    .gallery-thumb .gallery-img {
      max-height: 120px;
    }

    /* Prose */
    .portrait-gallery .gallery-img {
      object-fit: contain;
      background: var(--bg-3);
    }
    .portrait-gallery .gallery-featured .gallery-img { height: 420px; max-height: 420px; }
    .portrait-gallery .gallery-thumb .gallery-img { height: 140px; max-height: 140px; }

    .prose {
      color: var(--text);
      font-size: 1rem;
      line-height: 1.8;
    }
    .prose :global(h2) {
      color: var(--white);
      font-size: 1.375rem;
      font-weight: 700;
      margin: 2rem 0 0.75rem;
      letter-spacing: -0.02em;
    }
    .prose :global(h3) {
      color: var(--white);
      font-size: 1.125rem;
      font-weight: 600;
      margin: 1.5rem 0 0.625rem;
    }
    .prose :global(p) { margin: 0 0 1.125rem; }
    .prose :global(ul) {
      list-style: none;
      margin: 0 0 1.125rem;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
    }
    .prose :global(ol) {
      margin: 0 0 1.125rem 1.25rem;
      padding: 0;
    }
    .prose :global(ul li) {
      position: relative;
      padding-left: 1.75rem;
      margin-bottom: 0;
    }
    .prose :global(ul li)::before {
      content: '✓';
      position: absolute;
      left: 0;
      top: 0;
      color: var(--purple);
      font-weight: 700;
      font-size: 1rem;
    }
    .prose :global(ol li) { margin-bottom: 0.4rem; }
    .prose :global(strong) { color: var(--white); font-weight: 600; }
    .prose :global(a) { color: var(--purple); text-decoration: underline; text-underline-offset: 3px; }

    /* Lightbox trigger */
    .lb-trigger {
      cursor: zoom-in;
      position: relative;
    }
    .lb-hint {
      position: absolute;
      bottom: 0.5rem;
      right: 0.5rem;
      background: rgba(0,0,0,0.6);
      color: #fff;
      font-size: 0.6875rem;
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      opacity: 0;
      transition: opacity 0.2s;
      pointer-events: none;
    }
    .lb-trigger:hover .lb-hint { opacity: 1; }

    /* Lightbox overlay */
    #lb-overlay {
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: rgba(0, 0, 0, 0.92);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
    }
    #lb-overlay.open {
      opacity: 1;
      pointer-events: auto;
    }
    #lb-img {
      max-width: 92vw;
      max-height: 88vh;
      object-fit: contain;
      border-radius: 8px;
      box-shadow: 0 24px 80px rgba(0,0,0,0.6);
    }
    #lb-close,
    #lb-prev,
    #lb-next {
      position: absolute;
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.22);
      color: #fff;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.15s;
    }
    #lb-close:hover,
    #lb-prev:hover,
    #lb-next:hover { background: rgba(255,255,255,0.25); }

    #lb-close {
      top: 1.25rem;
      right: 1.25rem;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      font-size: 1rem;
    }
    #lb-prev,
    #lb-next {
      top: 50%;
      transform: translateY(-50%);
      width: 48px;
      height: 48px;
      border-radius: 50%;
      font-size: 2rem;
      line-height: 1;
    }
    #lb-prev { left: 1.25rem; }
    #lb-next { right: 1.25rem; }
    #lb-prev:disabled,
    #lb-next:disabled { opacity: 0.25; cursor: default; }

    #lb-counter {
      position: absolute;
      bottom: 1.25rem;
      left: 50%;
      transform: translateX(-50%);
      color: rgba(255,255,255,0.6);
      font-size: 0.8125rem;
      font-family: 'Sora', sans-serif;
    }

    @media (max-width: 600px) {
      #lb-prev { left: 0.5rem; }
      #lb-next { right: 0.5rem; }
      #lb-prev, #lb-next { width: 40px; height: 40px; font-size: 1.5rem; }
    }

    /* Responsive */
    /* Related projects */
    .related-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    .related-card {
      display: flex;
      flex-direction: column;
      background: var(--bg-2);
      border: 1px solid var(--border);
      border-radius: 10px;
      overflow: hidden;
      text-decoration: none;
      transition: border-color 0.2s, transform 0.2s;
    }
    .related-card:hover {
      border-color: var(--purple);
      transform: translateY(-2px);
    }

    .related-img-wrap {
      height: 200px;
      overflow: hidden;
      flex-shrink: 0;
      background: var(--bg-3);
    }

    .related-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
      display: block;
      transition: transform 0.3s ease;
    }
    .related-card:hover .related-img { transform: scale(1.03); }

    .related-img-placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-muted);
      font-size: 0.875rem;
    }

    .related-body {
      padding: 1.125rem;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .related-title {
      font-size: 1rem;
      font-weight: 700;
      color: var(--white);
      margin-bottom: 0.4rem;
    }

    .related-summary {
      font-size: 0.8125rem;
      color: var(--text-muted);
      line-height: 1.6;
      margin-bottom: 0.875rem;
      flex: 1;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .related-cta {
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--purple);
    }

    @media (max-width: 900px) {
      .hero-grid {
        grid-template-columns: 1fr;
        gap: 2.5rem;
      }
      .related-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 560px) {
      .related-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 480px) {
      .gallery-thumbs {
        grid-template-columns: repeat(2, 1fr);
      }
    }
  </style>

  <script>
    const overlay  = document.getElementById('lb-overlay') as HTMLElement;
    /* Move overlay to body so it isn't clipped by main's stacking context */
    document.body.appendChild(overlay);

    const lbImg    = document.getElementById('lb-img') as HTMLImageElement;
    const lbClose  = document.getElementById('lb-close') as HTMLButtonElement;
    const lbPrev   = document.getElementById('lb-prev') as HTMLButtonElement;
    const lbNext   = document.getElementById('lb-next') as HTMLButtonElement;
    const lbCounter= document.getElementById('lb-counter') as HTMLElement;

    const triggers = Array.from(document.querySelectorAll<HTMLElement>('.lb-trigger'));
    const images   = triggers.map(el => el.querySelector('img')!);
    let current    = 0;

    function show(index: number) {
      current = index;
      const img = images[current];
      lbImg.src = img.src;
      lbImg.alt = img.alt;
      lbCounter.textContent = `${current + 1} / ${images.length}`;
      lbPrev.disabled = current === 0;
      lbNext.disabled = current === images.length - 1;
    }

    function openLb(index: number) {
      show(index);
      overlay.classList.add('open');
      overlay.removeAttribute('aria-hidden');
      lbClose.focus();
    }

    function closeLb() {
      overlay.classList.remove('open');
      overlay.setAttribute('aria-hidden', 'true');
    }

    triggers.forEach((el, i) => {
      el.addEventListener('click', () => openLb(i));
    });

    lbClose.addEventListener('click', closeLb);
    lbPrev.addEventListener('click', () => { if (current > 0) show(current - 1); });
    lbNext.addEventListener('click', () => { if (current < images.length - 1) show(current + 1); });

    overlay.addEventListener('click', (e) => { if (e.target === overlay) closeLb(); });

    document.addEventListener('keydown', (e) => {
      if (!overlay.classList.contains('open')) return;
      if (e.key === 'Escape') closeLb();
      if (e.key === 'ArrowLeft' && current > 0) show(current - 1);
      if (e.key === 'ArrowRight' && current < images.length - 1) show(current + 1);
    });

    // Touch swipe support
    let touchStartX = 0;
    overlay.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
    overlay.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(dx) < 40) return;
      if (dx < 0 && current < images.length - 1) show(current + 1);
      if (dx > 0 && current > 0) show(current - 1);
    });
  </script>

</BaseLayout>
