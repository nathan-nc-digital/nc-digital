  @media (max-width: 760px) {
    .seo-card {
      grid-template-columns: 1fr;
    }
    .seo-img-wrap {
      height: 360px;
    }
    .seo-content {
      padding: 1.75rem 1.25rem;
    }
    .seo-client { font-size: 1.375rem; }
