  /* Reviews carousel */
  .reviews-viewport {
    overflow: hidden;
    border-radius: 14px;
  }

  .reviews-slides {
    display: flex;
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
    user-select: none;
    cursor: grab;
  }
  .reviews-slides:active { cursor: grabbing; }

  .review-slide {
    flex: 0 0 calc(33.333% - 0.84rem);
    margin-right: 1.25rem;
  }

  .review-card {
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.75rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 0.2s;
  }

  .review-stars {
    color: #f5c518;
    font-size: 1rem;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .review-text {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0;
    flex: 1;
  }

  .review-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }

  .review-name {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--white);
  }

  .review-time {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .review-project-link {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--purple-light);
    text-decoration: none;
    margin-top: 0.25rem;
    transition: color 0.2s;
  }
  .review-project-link:hover { color: var(--white); }

  .reviews-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.5rem;
  }

  .reviews-dots {
    display: flex;
    gap: 0.5rem;
  }

  .reviews-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }

  .reviews-dot.active {
    background: var(--purple);
    transform: scale(1.25);
  }

  .reviews-arrows {
    display: flex;
    gap: 0.625rem;
  }

  .reviews-arrow {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--bg-2);
    color: var(--text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }

  .reviews-arrow:hover {
    border-color: var(--purple);
    color: var(--white);
    background: rgba(135,80,247,0.1);
  }

  @media (max-width: 900px) {
    .review-slide {
      flex: 0 0 calc(50% - 0.625rem);
    }
  }

  @media (max-width: 560px) {
    .review-slide {
      flex: 0 0 100%;
      margin-right: 1.25rem;
    }
  }
</style>

<script>
  // SEO carousel
  (function () {
    const slides  = document.getElementById('seoSlides') as HTMLElement;
    const dotsWrap = document.getElementById('seoDots')!;
    const prevBtn  = document.getElementById('seoPrev')!;
    const nextBtn  = document.getElementById('seoNext')!;
    if (!slides) return;

    const items = slides.querySelectorAll('.seo-slide');
    const total = items.length;
    let current = 0;

    function buildDots() {
      dotsWrap.innerHTML = '';
      for (let i = 0; i < total; i++) {
        const d = document.createElement('button');
        d.className = 'reviews-dot' + (i === current ? ' active' : '');
        d.setAttribute('aria-label', `Go to slide ${i + 1}`);
        d.addEventListener('click', () => goTo(i));
        dotsWrap.appendChild(d);
      }
    }

    function goTo(n: number) {
      current = ((n % total) + total) % total;
      const slideWidth = (items[0] as HTMLElement).offsetWidth;
      slides.style.transform = `translateX(-${current * slideWidth}px)`;
      dotsWrap.querySelectorAll('.reviews-dot').forEach((d, i) => d.classList.toggle('active', i === current));
    }

    prevBtn.addEventListener('click', () => goTo(current - 1));
    nextBtn.addEventListener('click', () => goTo(current + 1));

    let touchX = 0;
    slides.addEventListener('touchstart', (e) => { touchX = e.touches[0].clientX; }, { passive: true });
    slides.addEventListener('touchend', (e) => {
      const dx = touchX - e.changedTouches[0].clientX;
      if (Math.abs(dx) > 40) goTo(dx > 0 ? current + 1 : current - 1);
    }, { passive: true });

    let dragStartX = 0;
    let dragging = false;
    slides.addEventListener('mousedown', (e) => { dragStartX = e.clientX; dragging = true; slides.style.cursor = 'grabbing'; });
    document.addEventListener('mouseup', (e) => {
      if (!dragging) return;
      dragging = false;
      slides.style.cursor = 'grab';
      const dx = dragStartX - e.clientX;
      if (Math.abs(dx) > 40) goTo(dx > 0 ? current + 1 : current - 1);
    });
    document.addEventListener('mouseleave', () => { if (dragging) { dragging = false; slides.style.cursor = 'grab'; } });
    slides.style.cursor = 'grab';

    window.addEventListener('resize', () => goTo(current));

    buildDots();
    goTo(0);

    const carousel = document.getElementById('seoCarousel')!;
    let autoTimer = window.setInterval(() => goTo(current + 1 < total ? current + 1 : 0), 4000);
    carousel.addEventListener('mouseenter', () => window.clearInterval(autoTimer));
    carousel.addEventListener('mouseleave', () => { autoTimer = window.setInterval(() => goTo(current + 1 < total ? current + 1 : 0), 4000); });
  })();

  // Reviews carousel
  (function () {
    const slides   = document.querySelector('.reviews-slides') as HTMLElement;
    const dotsWrap = document.getElementById('reviewsDots')!;
    const prevBtn  = document.getElementById('reviewsPrev')!;
    const nextBtn  = document.getElementById('reviewsNext')!;
    if (!slides) return;

    const items   = slides.querySelectorAll('.review-slide');
    const total   = items.length;
    let perPage   = 3;
    let current   = 0;

    function getPerPage() {
      if (window.innerWidth <= 560) return 1;
      if (window.innerWidth <= 900) return 2;
      return 3;
    }

    function maxPage() { return total - perPage; }

    function buildDots() {
      dotsWrap.innerHTML = '';
      const pages = maxPage() + 1;
      for (let i = 0; i < pages; i++) {
        const d = document.createElement('button');
        d.className = 'reviews-dot' + (i === current ? ' active' : '');
        d.setAttribute('aria-label', `Go to slide ${i + 1}`);
        d.addEventListener('click', () => goTo(i));
        dotsWrap.appendChild(d);
      }
    }

    function goTo(n: number) {
      current = Math.max(0, Math.min(n, maxPage()));
      const slideWidth = (items[0] as HTMLElement).offsetWidth + 20; // card width + gap
      slides.style.transform = `translateX(-${current * slideWidth}px)`;
      dotsWrap.querySelectorAll('.reviews-dot').forEach((d, i) => {
        d.classList.toggle('active', i === current);
      });
    }

    function init() {
      perPage = getPerPage();
      buildDots();
      goTo(current);
    }

    prevBtn.addEventListener('click', () => goTo(current - 1));
    nextBtn.addEventListener('click', () => goTo(current + 1));

    // Touch swipe
    let touchX = 0;
    slides.addEventListener('touchstart', (e) => { touchX = e.touches[0].clientX; }, { passive: true });
    slides.addEventListener('touchend', (e) => {
      const dx = touchX - e.changedTouches[0].clientX;
      if (Math.abs(dx) > 40) goTo(dx > 0 ? current + 1 : current - 1);
    }, { passive: true });

    // Mouse drag
    let dragStartX = 0;
    let dragging = false;
    slides.addEventListener('mousedown', (e) => {
      dragStartX = e.clientX;
      dragging = true;
      slides.style.cursor = 'grabbing';
    });
    document.addEventListener('mouseup', (e) => {
      if (!dragging) return;
      dragging = false;
      slides.style.cursor = 'grab';
      const dx = dragStartX - e.clientX;
      if (Math.abs(dx) > 40) goTo(dx > 0 ? current + 1 : current - 1);
    });
    document.addEventListener('mouseleave', () => {
      if (dragging) { dragging = false; slides.style.cursor = 'grab'; }
    });
    slides.style.cursor = 'grab';

    window.addEventListener('resize', () => {
      perPage = getPerPage();
      current = Math.min(current, maxPage());
      buildDots();
      goTo(current);
    });

    init();
  })();
</script>

</BaseLayout>
