// Google reviews (verbatim). Project context is added only where the review links to a case study.
const reviews = [
  { name: 'Jake Lewis',       time: '1 hour ago',   href: '',                                        project: '',                            context: '',                                text: 'I couldn\'t be happier with the website that was designed for my business. From the very beginning, the team was professional, responsive, and easy to work with. They took the time to understand exactly what I wanted and turned my ideas into a modern, professional, and user-friendly website that exceeded my expectations. Communication was excellent throughout the entire process, and any questions or changes I had were handled quickly and efficiently. The attention to detail and quality of their work really stands out. I would highly recommend them to anyone looking for a reliable, talented web design company. Thank you for delivering a website I\'m genuinely proud of!' },
  { name: 'Laura Ann',        time: '2 months ago', href: '/portfolio/ir-energy/',                  project: 'IR Energy',                   context: 'Renewable energy · Homepage redesign & local SEO', text: 'Nathan redesigned our website homepage exactly the way we envisioned it. He was attentive to what we wanted, incredibly helpful throughout the process and very knowledgeable. Nathan made everything smooth and easy, we\'re so happy with the final result. Our team from IR Energy would highly recommend him!' },
