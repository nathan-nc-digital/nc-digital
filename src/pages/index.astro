// Homepage-only structured data. The Organization/ProfessionalService entity lives in BaseHead
// (@id #localbusiness) on every page, so it is referenced here rather than repeated.
const siteUrl = 'https://nc-digital.co.uk';
const businessId = `${siteUrl}/#localbusiness`;
const stripHtml = (html: string) => html.replace(/<[^>]+>/g, '');
const homeSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: 'NC Digital',
      inLanguage: 'en-GB',
      publisher: { '@id': businessId },
    },
    {
      '@type': 'WebPage',
      '@id': `${siteUrl}/#webpage`,
      url: `${siteUrl}/`,
      name: 'NC Digital — Web Design & SEO South Wales',
      description: homeMetaDescription,
      inLanguage: 'en-GB',
      isPartOf: { '@id': `${siteUrl}/#website` },
      about: { '@id': businessId },
    },
    ...services.map(({ title, desc, href }) => ({
      '@type': 'Service',
      name: title,
      description: desc,
      url: `${siteUrl}${href}`,
      serviceType: title,
      provider: { '@id': businessId },
      areaServed: [
        { '@type': 'AdministrativeArea', name: 'South Wales' },
        { '@type': 'City', name: 'Merthyr Tydfil' },
        { '@type': 'City', name: 'Cardiff' },
        { '@type': 'City', name: 'Swansea' },
        { '@type': 'City', name: 'Newport' },
      ],
    })),
    {
      '@type': 'FAQPage',
      '@id': `${siteUrl}/#faq`,
      mainEntity: faqs.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: stripHtml(a) },
      })),
    },
  ],
};
---

<BaseLayout
  title="NC Digital — Web Design & SEO South Wales"
  description={homeMetaDescription}
>
  <JsonLD slot="head" schema={homeSchema} />

  <!-- HERO -->
  <section style="padding:5rem 0 4rem; position:relative; overflow:hidden;">
    <div style="position:absolute; top:-100px; right:0; width:600px; height:600px; background:radial-gradient(circle, #8750f720 0%, transparent 70%); pointer-events:none;"></div>

    <div class="container site-pad layout-hero">

      <div>
        <p data-animate="fade-up" class="eyebrow" style="margin-bottom:1rem;">Web Design · SEO · South Wales</p>
        <h1 data-animate="fade-up" style="margin-bottom:1.25rem;">
          Affordable Web Design & SEO in South Wales
        </h1>
        <p data-animate="fade-up" style="color:var(--text-muted); font-size:1.125rem; line-height:1.7; margin-bottom:2rem; max-width:480px;">
          {settings?.heroSubtext ?? 'Affordable web design and local SEO for South Wales small businesses.'}
        </p>
        <p data-animate="fade-up" style="color:var(--text-muted); font-size:0.9375rem; line-height:1.6; margin:-1rem 0 1rem; max-width:480px;">
          NC Digital is a web design and SEO agency based in Merthyr Tydfil, helping small and growing businesses across Cardiff, Swansea, Newport and the wider South Wales area with <a href="/services/web-design/" class="hero-link">WordPress websites</a>, <a href="/services/ecommerce-development/" class="hero-link">WooCommerce online shops</a> and <a href="/services/local-seo-google-ranking/" class="hero-link">local SEO</a>.
        </p>
        <p data-animate="fade-up" style="color:var(--text-muted); font-size:0.9375rem; line-height:1.6; margin:0 0 2rem; max-width:480px;">
          Founded in 2025 by <a href="/about/" class="hero-link">Nathan Constance</a> — a professional web developer since 2015, who built and ranked his first website back in 2008.
        </p>
        <div data-animate="fade-up" style="display:flex; gap:1rem; flex-wrap:wrap;">
          <a href="/contact/" class="btn-primary">
            Get a free quote →
          </a>
          <a href="/portfolio/" class="btn-outline">
            {settings?.heroCTASecondary ?? 'See our work'}
          </a>
        </div>
      </div>

      <div style="position:relative; display:flex; justify-content:center;">
        <div style="position:absolute; inset:-40px; background:radial-gradient(ellipse at center, rgba(135,80,247,0.22) 0%, rgba(135,80,247,0.06) 55%, transparent 75%); pointer-events:none;"></div>
        <Image
          src={nathanImg}
          alt="Nathan Constance, founder and web developer at NC Digital, Merthyr Tydfil"
          width={570}
          data-animate="fade-in"
          class="nathan-photo"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          style="border-radius:16px; border:1px solid rgba(135,80,247,0.3); display:block; width:380px; max-width:100%; height:auto; position:relative; box-shadow:0 0 60px rgba(135,80,247,0.18), 0 24px 48px rgba(0,0,0,0.4);"
        />
      </div>

    </div>
  </section>

  <!-- STATS BAR -->
  <section style="padding:2rem 0;">
    <div class="container site-pad layout-stats">
      {stats.map(({ value, label }) => (
        <div style="text-align:center;">
          <div data-animate="counter" style="font-size:1.75rem; font-weight:800; color:var(--purple);">{value}</div>
          <div style="font-size:0.875rem; color:var(--text-muted); margin-top:0.25rem;">{label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" style="padding:5rem 0;">
    <div class="container site-pad">
      <div style="text-align:center; margin-bottom:3.5rem;">
        <p class="eyebrow" style="margin-bottom:0.75rem;">What we do</p>
        <h2 data-animate="fade-up" style="margin:0 auto 1rem;">Everything your business needs to grow online</h2>
        <p data-animate="fade-up" style="color:var(--text-muted); font-size:1.0625rem; margin:0 auto; line-height:1.7; max-width:640px;">
          Web design, WordPress development, ecommerce, hosting, maintenance and local SEO for small businesses across South Wales. One agency, every service — no juggling multiple suppliers.
        </p>
      </div>

      <div data-animate="stagger" class="services-list">
        {services.map(({ num, icon, title, desc, href }) => (
          <a href={href} class="svc-row">
            <div class="svc-left">
<div class="svc-icon" set:html={icon} />
              <div>
                <h3 class="svc-title">{title}</h3>
                <p class="svc-desc">{desc}</p>
              </div>
            </div>
