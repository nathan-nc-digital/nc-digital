  /* SEO Results carousel */
  .seo-viewport {
    overflow: hidden;
    border-radius: 16px;
  }

  .seo-slides {
    display: flex;
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }

  .seo-slide {
    flex: 0 0 100%;
  }

  .seo-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    background: var(--bg);
    min-height: 420px;
  }

  .seo-img-wrap {
    overflow: hidden;
